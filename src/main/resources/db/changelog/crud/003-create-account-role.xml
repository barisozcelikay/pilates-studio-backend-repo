<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-account-role" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="account_role">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_account_role"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="account_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="role_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                schemaName="pilates_studio"
                tableName="account_role"
                columnNames="account_id, role_id"
                constraintName="uk_account_role"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="account_role"
                baseColumnNames="account_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="account"
                referencedColumnNames="id"
                constraintName="fk_account_role_account"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="account_role"
                baseColumnNames="role_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="role"
                referencedColumnNames="id"
                constraintName="fk_account_role_role"
                onDelete="CASCADE"/>

    </changeSet>

</databaseChangeLog>
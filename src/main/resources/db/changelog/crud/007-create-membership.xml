<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-membership" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="membership">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_membership"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="account_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="package_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Paket snapshot bilgileri -->

            <column
                    name="package_name"
                    type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="duration_days"
                    type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column
                    name="price"
                    type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>

            <!-- Üyelik tarihleri -->

            <column
                    name="start_date"
                    type="DATE">
                <constraints nullable="false"/>
            </column>

            <column
                    name="end_date"
                    type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Durum -->

            <column
                    name="status"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <!-- Audit -->

        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="membership"
                baseColumnNames="account_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="account"
                referencedColumnNames="id"
                constraintName="fk_membership_account"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="membership"
                baseColumnNames="package_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="package"
                referencedColumnNames="id"
                constraintName="fk_membership_package"/>

    </changeSet>

</databaseChangeLog>
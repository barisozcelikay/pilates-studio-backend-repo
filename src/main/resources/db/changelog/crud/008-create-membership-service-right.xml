<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-membership-service-right" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="membership_service_right">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_membership_service_right"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="membership_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="service_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="total_lesson_count"
                    type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column
                    name="remaining_lesson_count"
                    type="INTEGER">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                schemaName="pilates_studio"
                tableName="membership_service_right"
                columnNames="membership_id, service_id"
                constraintName="uk_membership_service_right_membership_service"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="membership_service_right"
                baseColumnNames="membership_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="membership"
                referencedColumnNames="id"
                constraintName="fk_membership_service_right_membership"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="membership_service_right"
                baseColumnNames="service_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="service"
                referencedColumnNames="id"
                constraintName="fk_membership_service_right_service"/>

    </changeSet>


</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-create-lesson-instructor" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="lesson_instructor">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_lesson_instructor"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="lesson_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="instructor_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="lesson_instructor"
                baseColumnNames="lesson_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="lesson"
                referencedColumnNames="id"
                constraintName="fk_lesson_instructor_lesson"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="lesson_instructor"
                baseColumnNames="instructor_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="account"
                referencedColumnNames="id"
                constraintName="fk_lesson_instructor_instructor"/>

    </changeSet>

</databaseChangeLog>
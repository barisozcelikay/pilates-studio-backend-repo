<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017-create-payment" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="payment">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_payment"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <!-- Hangi satışa ait -->

            <column
                    name="sale_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Ödeme tutarı -->

            <column
                    name="amount"
                    type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>

            <!-- Ödeme yöntemi -->

            <column
                    name="payment_method"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <!-- Ödeme durumu -->

            <column
                    name="status"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <!-- Ödeme zamanı -->

            <column
                    name="paid_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <!-- Açıklama / referans bilgisi -->

            <column
                    name="note"
                    type="VARCHAR(500)"/>

            <!-- Ödemeyi kaydeden kullanıcı -->

            <column
                    name="created_by_account_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Audit -->



        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="payment"
                baseColumnNames="sale_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="sale"
                referencedColumnNames="id"
                constraintName="fk_payment_sale"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="payment"
                baseColumnNames="created_by_account_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="account"
                referencedColumnNames="id"
                constraintName="fk_payment_created_by_account"/>

        <createIndex
                schemaName="pilates_studio"
                tableName="payment"
                indexName="idx_payment_sale_id">

            <column name="sale_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>
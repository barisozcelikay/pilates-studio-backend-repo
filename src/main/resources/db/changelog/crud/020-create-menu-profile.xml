<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="020-create-menu-profile" author="baris">

        <createTable
                schemaName="pilates_studio"
                tableName="menu_profile">

            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_menu_profile"
                        nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="menu_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="profile_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="menu_profile"
                baseColumnNames="menu_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="menu"
                referencedColumnNames="id"
                constraintName="fk_menu_profile_menu"/>

        <addForeignKeyConstraint
                baseTableSchemaName="pilates_studio"
                baseTableName="menu_profile"
                baseColumnNames="profile_id"
                referencedTableSchemaName="pilates_studio"
                referencedTableName="profile"
                referencedColumnNames="id"
                constraintName="fk_menu_profile_profile"/>

        <addUniqueConstraint
                schemaName="pilates_studio"
                tableName="menu_profile"
                columnNames="menu_id, profile_id"
                constraintName="uk_menu_profile_menu_profile"/>

    </changeSet>

</databaseChangeLog>
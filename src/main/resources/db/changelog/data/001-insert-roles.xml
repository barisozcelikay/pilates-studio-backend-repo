<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-insert-initial-role" author="bozcelikay">

        <insert
                schemaName="pilates_studio"
                tableName="role">

            <column name="code" value="ROLE_ADMIN"/>
            <column name="name" value="Yönetici Rolü Yetkisi"/>

        </insert>

        <insert
                schemaName="pilates_studio"
                tableName="role">

            <column name="code" value="ROLE_INSTRUCTOR"/>
            <column name="name" value="Eğitmen Rolü Yetkisi"/>

        </insert>

        <insert
                schemaName="pilates_studio"
                tableName="role">

            <column name="code" value="ROLE_MEMBER"/>
            <column name="name" value="Üye Rolü Yetkisi"/>

        </insert>

    </changeSet>

</databaseChangeLog>